{
  "cursor_animation": {
    "enabled": true
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "sidebar_side": "left"
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "model": "gemini-3.8-flash-medium"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "effort": "high",
        "model": "opencode-go/glm-5.3-flash"
      },
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "golang": true,
    "html": true,
    "nix": true,
    "tailwind": true,
    "vue": true,
    "crystal": true,
    "java": true,
    "angular": true
  },
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_features": {
    "calt": true,
    "cv01": true,
    "zero": true
  },
  "buffer_font_size": 16,
  "buffer_font_weight": 600,
  "buffer_line_height": "standard",
  "cli_default_open_behavior": "existing_window",
  "code_lens": "on",
  "collaboration_panel": {
    "dock": "right"
  },
  "colorize_brackets": true,
  "completion_menu_item_kind": "symbol",
  "cursor_blink": false,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "disable_ai": false,
  "document_symbols": "off",
  "file_finder": {
    "modal_max_width": "xlarge"
  },
  "file_types": {
    "Angular": [
      "*.html"
    ]
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "gutter": {
    "line_numbers": true
  },
  "icon_theme": {
    "dark": "Catppuccin Latte",
    "light": "Catppuccin Latte",
    "mode": "dark"
  },
  "inlay_hints": {
    "enabled": false,
    "show_background": false
  },
  "jsx_tag_auto_close": {
    "enabled": true
  },
  "languages": {
    "Angular": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "Go": {
      "inlay_hints": {
        "enabled": true
      },
      "language_servers": [
        "gopls",
        "golangci-lint"
      ]
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "language_servers": [
        "angular",
        "..."
      ]
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxc"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "language_servers": [
        "!typescript-language-server",
        "angular",
        "vtsls"
      ],
      "prettier": {
        "allowed": false
      }
    },
    "Vue.js": {
      "language_servers": [
        "vue-language-server",
        "!typescript-language-server",
        "tailwindcss-language-server",
        "vtsls"
      ]
    },
    "Crystal": {
      "format_on_save": "on",
      "language_servers": [
        "crystalline"
      ]
    }
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
        ]
      }
    },
    "gopls": {
      "initialization_options": {
        "analyses": {
          "nilness": true,
          "shadow": true,
          "unusedwrite": true,
          "useany": true
        },
        "gofumpt": true,
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true
        },
        "staticcheck": true
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "run": "onType",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": [
          "cva",
          "cx"
        ],
        "experimental": {
          "classRegex": [
            "(?:cls|className|\\w*Classes\\w*)\\s*(?:=|:)\\s*['\"`]([^'\"`]*)['\"`]",
            "\\.className\\s*\\+?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute(?:NS)?\\([^)]*?['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.(?:add|remove|toggle|contains)\\(([^)]*)\\)",
            "\\.classList\\.replace\\(([^)]*)\\)",
            "\\b\\w*Classes\\w*\\s*=\\s*\\{([\\s\\S]*?)\\}",
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            ":class=\"([^\"]*)\"",
            ":class='([^']*)'"
          ]
        },
        "includeLanguages": {
          "vue": "html"
        }
      }
    },
    "vue": {
      "settings": {
        "vue.inlayHints.inlineHandlerLeading": true,
        "vue.inlayHints.missingProps": true,
        "vue.inlayHints.optionsWrapper": true,
        "vue.inlayHints.vBindShorthand": true
      }
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "pane_split_direction_vertical": "right",
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "auto_open": {
      "on_drop": true
    },
    "auto_reveal_entries": true,
    "bold_folder_labels": false,
    "diagnostic_badges": true,
    "dock": "right",
    "drag_and_drop": true,
    "file_icons": true,
    "git_status": true,
    "git_status_indicator": true,
    "hide_gitignore": false,
    "hide_hidden": false,
    "hide_root": false,
    "starts_open": true,
    "sticky_scroll": true,
    "folder_indicator": "icon"
  },
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "show": "never"
  },
  "semantic_tokens": "combined",
  "soft_wrap": "editor_width",
  "tab_bar": {
    "show": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all"
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Mocha",
    "mode": "dark"
  },
  "theme_overrides": {
    "Catppuccin Mocha": {
      "border": "#1e1e2e",
      "border.variant": "#1e1e2e",
      "hint": "#89dceb",
      "info": "#cba6f7",
      "syntax": {
        "boolean": {
          "font_style": "italic"
        },
        "comment": {
          "font_style": "italic"
        },
        "comment.doc": {
          "font_style": "italic"
        },
        "keyword": {
          "font_style": "italic"
        },
        "keyword.control": {
          "font_style": "italic"
        },
        "keyword.control.conditional": {
          "font_style": "italic"
        },
        "keyword.control.repeat": {
          "font_style": "italic"
        },
        "keyword.control.return": {
          "font_style": "italic"
        },
        "keyword.function": {
          "font_style": "italic"
        },
        "keyword.operator": {
          "font_style": "normal"
        },
        "keyword.storage": {
          "font_style": "italic"
        },
        "keyword.storage.type": {
          "font_style": "italic"
        },
        "keyword.type": {
          "font_style": "italic"
        },
        "null": {
          "font_style": "italic"
        },
        "self": {
          "font_style": "italic"
        },
        "type": {
          "font_style": "italic"
        },
        "type.builtin": {
          "font_style": "italic"
        }
      }
    }
  },
  "toolbar": {
    "breadcrumbs": true,
    "code_actions": false,
    "selections_menu": false
  },
  "ui_font_family": "CaskaydiaCove Nerd Font",
  "ui_font_size": 15.5,
  "ui_font_weight": 700,
  "vim_mode": true,
  "which_key": {
    "enabled": true
  }
}
