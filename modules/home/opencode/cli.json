{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "medium",
    "tps": true
  },
  "mini": {
    "footer": "show",
    "work_spinner": "density-wave"
  },
  "keybinds": {
    "sidebar_toggle": "ctrl+s",
    "dialog.mcp.toggle": "ctrl+m"
  },
  "plugins": [
    "./herdr-opencode"
  ]
}
